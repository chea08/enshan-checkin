#!name=恩山论坛签到
#!desc=登录后自动获取 Cookie，每日 08:00 签到；遇登录失效或网站验证时通知。
#!system=ios
#!author=Minis
#!homepage=https://github.com/chea08/-
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Checkmark.png

[Script]
# 打开论坛首页或任意论坛页面时获取登录 Cookie，不读取请求正文。
恩山论坛Cookie获取 = type=http-request,pattern=^https://www\.right\.com\.cn/forum/,requires-body=false,script-path=https://raw.githubusercontent.com/chea08/-/refs/heads/main/enshan_cookie_capture_qx.js?v=20261115,timeout=5

# 每天设备本地时间 08:00 自动签到。
恩山论坛签到 = type=cron,cronexp="0 8 * * *",timeout=60,script-path=https://raw.githubusercontent.com/chea08/-/refs/heads/main/enshan_checkin_compatible.js?v=20261115

[MITM]
hostname = %APPEND% www.right.com.cn
